#!/usr/bin/env bash
# Fetch PR review threads as compact, readable text for Claude Code.
# Usage: gh-review-threads <owner> <repo> <pr_number> <review_id> [--unresolved-only]
set -euo pipefail

unresolved_only=false
args=()
for a in "$@"; do
  case "$a" in
    --unresolved-only) unresolved_only=true ;;
    *) args+=("$a") ;;
  esac
done

if [[ ${#args[@]} -ne 4 ]]; then
  echo "Usage: gh-review-threads <owner> <repo> <pr_number> <review_id> [--unresolved-only]" >&2
  exit 1
fi

owner="${args[0]}"
repo="${args[1]}"
pr="${args[2]}"
review_id="${args[3]}"

# Review bots (Copilot especially) wrap every finding in ~400 characters of
# <picture>/<source>/<img> severity artwork that renders as nothing useful in a
# terminal. gh-review-tidy parses it out and leaves a short badge behind; if it
# is missing, fall through and print the bodies raw rather than failing.
if command -v gh-review-tidy >/dev/null 2>&1; then
  tidy() { gh-review-tidy; }
else
  tidy() { cat; }
fi

# Both connections are paginated: busy PRs blow past 100 reviews/threads, and a
# truncated review list used to silently produce zero output.
if ! threads="$(gh api graphql --paginate \
  -f owner="$owner" -f repo="$repo" -F pr="$pr" -f query='
query($owner: String!, $repo: String!, $pr: Int!, $endCursor: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $pr) {
      reviewThreads(first: 50, after: $endCursor) {
        pageInfo { hasNextPage endCursor }
        nodes {
          id
          isResolved
          comments(first: 50) {
            nodes {
              databaseId
              body
              path
              line
              author { login }
              pullRequestReview { databaseId }
            }
          }
        }
      }
    }
  }
}' | jq -s '[.[].data.repository.pullRequest.reviewThreads.nodes[]]' 2>/dev/null | tidy)"; then
  echo "Failed to fetch review threads for $owner/$repo#$pr." >&2
  exit 1
fi

if ! reviews="$(gh api graphql --paginate \
  -f owner="$owner" -f repo="$repo" -F pr="$pr" -f query='
query($owner: String!, $repo: String!, $pr: Int!, $endCursor: String) {
  repository(owner: $owner, name: $repo) {
    pullRequest(number: $pr) {
      reviews(first: 100, after: $endCursor) {
        pageInfo { hasNextPage endCursor }
        nodes { databaseId body state author { login } }
      }
    }
  }
}' | jq -s '[.[].data.repository.pullRequest.reviews.nodes[]]' 2>/dev/null | tidy)"; then
  echo "Failed to fetch reviews for $owner/$repo#$pr." >&2
  exit 1
fi

jq -rn --argjson threads "$threads" --argjson reviews "$reviews" \
       --argjson rid "$review_id" --argjson unresolvedOnly "$unresolved_only" '
  # Review submission comment. A review missing from the list (deleted, or an
  # API hiccup) must not suppress its threads, so fall back to a stub.
  (($reviews[] | select(.databaseId == $rid)) // null) as $review |
  (if $review then
    "Review by @" + ($review.author.login // "unknown") + " (" + $review.state + ")" +
    (if ($review.body // "") != "" then
      "\n" + ($review.body | split("\n") | map("  " + .) | join("\n"))
    else "" end)
  else
    "Review \($rid) (details unavailable)"
  end),

  # Threaded inline comments
  ([
    $threads[]
    | select(.comments.nodes | any(.pullRequestReview.databaseId == $rid))
    | select(($unresolvedOnly | not) or (.isResolved | not))
  ] | to_entries[] |
    .value as $t |
    "---\nThread \(.key + 1)" +
    (if $t.isResolved then " [RESOLVED]" else " [UNRESOLVED]" end) +
    " | threadId: " + $t.id + "\n" +
    ($t.comments.nodes[0] | "  " + .path +
      (if .line then ":" + (.line | tostring) else "" end)) +
    "\n" +
    ([$t.comments.nodes | to_entries[] |
      .value as $c |
      "  @" + ($c.author.login // "unknown") +
      (if .key == 0 then " (review)" else " (reply)" end) +
      " [commentId: " + ($c.databaseId | tostring) + "]:\n" +
      ($c.body | split("\n") | map("    " + .) | join("\n"))
    ] | join("\n"))
  )
'
