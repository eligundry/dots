#!/usr/bin/env bash
# Print a file as it exists at a given ref, with line numbers, without needing
# a local checkout. Used for surrounding context during PR review.
# Usage: gh-pr-file <owner> <repo> <ref> <path>
set -euo pipefail

if [[ $# -ne 4 ]]; then
  echo "Usage: gh-pr-file <owner> <repo> <ref> <path>" >&2
  exit 1
fi

gh api "repos/$1/$2/contents/$4?ref=$3" -H "Accept: application/vnd.github.raw" | cat -n
